# 1Password secret references for fetch.py / serve.py. No secrets live here;
# each op:// ref resolves only for someone signed in to the matching account.
# Point these at your own 1Password item, then run:
#   op run --env-file egym.op.env -- python3 serve.py
EGYM_BRAND=op://Personal/egym/brand
EGYM_USERNAME=op://Personal/egym/username
EGYM_PASSWORD=op://Personal/egym/newPassword
